//Requirement 1: Keep the class in the required package 
package edu.monmouth.campusvehicle;

public class CampusVehihcle {
	
	//Requirement 1: Protect the attributes using private fields.
	private String id; 
	private String location;
	private boolean available; 
	
	//Requirements 3 and 5: Use UNKNOWN for invalid values.
	// The references to "name" and "type" in the assignment
	// are interpreted as referring to id and location. 
	private static final String UNKNOWN = "UNKNOWN";
	
	//Provisional default values.
	//Default constructor: tested in Requirements 8(b) - 8(c)
	public CampusVehicle() {
		setId(null);
		setLocation(null);
		setAvailable(false);

	}
	
	// Constructor with all attributes: tested in 8(g) - 8(h) and 8(l) .
	//Delegate alidation and assignment to the mutators.
	public CampusVehicle(String id, String location, boolean available) {
		
		setId(id);
		setLocation(location);
		setAvailable(available);
	}
	
	// ID accessor: retrieve the stored ID.
	public String getId() {
		return id;
		
	}
	
	// Requirements 2 and 3: Validate the ID. 
	// Store UNKOWN whenever the ID is invalid. 
	public void setId(String id) {
		
		// Requirement 2: Reject a null String.
		if (id == null) { 
			this.id =UNKNOWN;
		
		// Requirement 2: Reject an empty String. 
		} else if (id.length() == 0) {
			this.id = UNKNOWN;	
		
		//Requirement 2: Reject lengths outside the range 4 through 12.
		} else if (id.length() < 4 || id.length() > 12) {
			this.id = UNKNOWN;
		
		//Requirements 2 and 7: Require MU at the beginning,
		// ignoring capitalization. 
		
		} else if (!id.substring(0,2).equalsIgnoreCase("MU")) {
			this.id = UNKNOWN;
		
		//Store the valid ID.
		} else {
			this.id = id; 
			
		}
	}
	
	//Location accessor: retrieve he stored location. 
    public String getLocation() {
    	return location;	
    }
    
    //Requirements 4 and 5: Validate the location. 
    //Store UNKNOWN whenever the location is invalid.
    public void setLocation(String location) {
    	
    	//Requirement 4: Reject a null String. 
    	if (location == null) {
    		this.location = UNKNOWN;
    	
    	// Requirement 4: Reject an empty String. 
    	} else if (location.length() == 0) {
    		this.location = UNKNOWN;
    	
    	//Requirements 4 and 7: Accept only the five permitted
    	// locations, ignoring capitalization. 
    	} else if (location.equalsIgnoreCase("Library")
    			|| location.equalsIgnoreCase("University Bluffs")
    			|| location.equalsIgnoreCase("Parking Lot")
    			|| location.equalsIgnoreCase("Spruce Hall")
    			|| location.equalsIgnoreCase("Laurel Hall")) {
    		this.location = location; 
    	// Requirement 5: Reject any other location. 
    	} else {
    		this.location = UNKNOWN;
    	}
    }
    
    //Availability accessor: retrieve the current availability. 
    // Used in Requirements 8(f), 8(k), and 8(l).
    public boolean isAvailable() {
    	return available; 	
    }
    
    //Availability mutator: update the availability.
    //Used in Requirements 8(d) and 8(i).
    public void setAvailable(boolean available) {
    	this.available = available; 
    }
    
    //Requirement 6: Set available to false only if it is currently true.
    //If the vehicle is already unavailable, leave it unchanged. 
    public void checkout() { 
    	if (available) {
    		available = false;
    		
    	}
    }
    //Return the vehicle and make it available again. 
    // Tested in Requirements 8(f), 8(k), 8(l)
    public void returnVehicle() { 
    	available = true; 
    	
    }
}
